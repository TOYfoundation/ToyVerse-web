---
import { npc } from '../../lib/npc.js';
import { t, tv } from '../../i18n';
interface Props { lang: string }
const { lang } = Astro.props;
const names = tv<string[]>(lang, 'demo.npc.names');
---
<h2>{t(lang, 'demo.npc.title')}</h2>
<div class="sim">
  <div class="np" id="npcs" data-t={JSON.stringify(tv(lang, 'demo.npc'))}>
    {names.map((n, i) => <button class="nb" data-i={i} aria-pressed="false"><Fragment set:html={npc(i)} /><div>{n}</div></button>)}
  </div>
  <div class="bub" id="bub"><p id="sb" role="status">{t(lang, 'demo.npc.intro')}</p></div>
  <div id="qs"></div>
</div>
<script>
  import { init } from '../../scripts/demos/npc.js';
  init();
</script>
