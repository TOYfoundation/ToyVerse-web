---
import { t, tv } from '../../i18n';
interface Props { lang: string }
const { lang } = Astro.props;
const T = tv<Record<string, string>>(lang, 'demo.mint');
---
<div class="sim" id="mint" data-t={JSON.stringify(T)}>
  <svg id="mm" viewBox="0 0 360 230" role="img" aria-label={T.label} style="width:100%;height:auto">
    <defs><clipPath id="hp"><polygon points="170,60 230,60 215,130 185,130"></polygon></clipPath></defs>
    <rect x="20" y="146" width="150" height="10" rx="5" fill="var(--ln)"></rect>
    <line class="fl" x1="24" y1="151" x2="166" y2="151" stroke="var(--acc)" stroke-width="3" stroke-dasharray="4 10"></line>
    <g clip-path="url(#hp)"><rect id="hl" x="165" y="130" width="70" height="0" fill="var(--acc)" opacity=".8"></rect></g>
    <polygon points="170,60 230,60 215,130 185,130" fill="none" stroke="var(--ink)" stroke-width="2"></polygon>
    <text x="200" y="52" text-anchor="middle" font-size="11" fill="var(--ink)">{T.pool}</text>
    <path d="M200 130V176H290" fill="none" stroke="var(--ln)" stroke-width="8"></path>
    <path id="pp" d="M200 130V176H290" fill="none" stroke="var(--acc)" stroke-width="3" opacity="0"></path>
    <rect x="256" y="40" width="6" height="112" fill="var(--ln)"></rect><rect x="318" y="40" width="6" height="112" fill="var(--ln)"></rect><rect x="256" y="40" width="68" height="10" fill="var(--ln)"></rect>
    <g id="ps"><rect x="270" y="52" width="40" height="40" fill="var(--acc)"></rect><rect x="287" y="42" width="6" height="10" fill="var(--ink)"></rect></g>
    <rect x="268" y="146" width="44" height="32" rx="3" fill="none" stroke="var(--ink)" stroke-width="2"></rect>
    <rect id="mb2" x="272" y="150" width="36" height="24" rx="2" fill="var(--acc)" opacity="0"></rect>
    <path d="M312 164H341V196" fill="none" stroke="var(--ln)" stroke-width="6"></path>
    <rect x="320" y="196" width="40" height="24" rx="3" fill="none" stroke="var(--ink)" stroke-width="2"></rect>
    <text x="340" y="212" text-anchor="middle" font-size="9" fill="var(--ink)" id="tz">0</text>
    <g id="dv"></g>
    <text x="20" y="193" font-size="10" fill="var(--mu)">{T.chain}</text>
    <g id="cr2" transform="translate(20 198)"></g>
  </svg>
  <p id="ml" role="status" style="min-height:3rem;margin:.4rem 0">{T.start}</p>
  <div><button class="btn" data-k="H">{T.addPhone}</button><button class="btn" data-k="P">{T.addPi}</button><button class="btn" data-k="C">{T.addPc}</button></div>
  <div><button class="btn al" id="sg">{T.sign}</button><button class="btn al" id="sp2">{T.spam}</button><button class="btn al" id="rs">{T.reset}</button></div>
  <p style="margin:.6rem 0 0">{T.blocks}: <b id="kb">0</b> · {T.minted}: <b id="km2">0</b> TOY · {T.devices}: <b id="kd">0</b></p>
</div>
<p>{t(lang, 'pages.mint.text')}</p>
<script>
  import { init } from '../../scripts/demos/mint.js';
  init();
</script>
